# ===== 必須 =====
# Supabase > Project Settings > Database > Connection string > "Transaction pooler"（ポート6543）
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# LINE Developers > LINEミニアプリチャネル > ウェブアプリ設定 の LIFF URL のうち
# 「https://miniapp.line.me/」以降の部分（例: 1234567890-abcdefgh）
NEXT_PUBLIC_LIFF_ID=1234567890-abcdefgh
# 同じLINEミニアプリチャネルの「チャネル基本設定」にあるチャネルID（IDトークン検証に使用）
LINE_LOGIN_CHANNEL_ID=1234567890

# LINE Developers > Messaging API チャネル > 「チャネルアクセストークン（長期）」
LINE_CHANNEL_ACCESS_TOKEN=

# 管理者の LINE ユーザーID（カンマ区切りで複数可）。/admin を開くと自分のIDが表示されます
ADMIN_LINE_USER_IDS=

# ===== 任意 =====
# 通知メッセージ内リンクのベースURL。LINEログインチャネルのLIFFアプリで作った場合は https://liff.line.me
# LIFF_URL_BASE=https://miniapp.line.me
NEXT_PUBLIC_SHOP_NAME=サンプルサロン
# 1枠の長さ（分）
SLOT_MINUTES=60
# 何日先まで予約可能か
BOOKING_DAYS_AHEAD=30
# 開始の何時間前まで予約可能か
MIN_LEAD_HOURS=2
# 1人が同時に持てる予約（承認待ち＋確定）の上限
MAX_ACTIVE_PER_USER=3

# Vercel Cron（/api/cron/keepalive）の認証用シークレット。
# 16文字以上のランダムな文字列。`openssl rand -hex 32` などで生成し、Vercelの環境変数に設定する
CRON_SECRET=

# ===== ローカル開発用（本番では設定しない） =====
# LINE なしで動作確認する場合: NEXT_PUBLIC_DEV_MODE=1 と DEV_AUTH=1 を設定し、
# http://localhost:3000/?as=dev-user（お客様） / http://localhost:3000/admin?as=dev-admin（管理者）で開く
# NEXT_PUBLIC_DEV_MODE=1
# DEV_AUTH=1
# ADMIN_LINE_USER_IDS=dev-admin
